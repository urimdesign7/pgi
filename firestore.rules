rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'urimdesign7@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isEmailVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidCategory(category) {
      return category in [
        '공지',
        '갤러리',
        '기도말씀 컨퍼런스',
        '화요예배',
        '제자스쿨',
        '청청캠프',
        '공지사항'
      ];
    }

    function isValidImageUrl(url) {
      return url is string &&
        url.size() <= 400000 &&
        (
          url == '' ||
          url.matches('^https?://.*') ||
          url.matches('^/.*') ||
          url.matches('^data:image/(jpeg|jpg|png|webp|gif);base64,[A-Za-z0-9+/=]+$')
        );
    }

    function isValidImageUrls(urls) {
      return urls is list &&
        urls.size() <= 10 &&
        (urls.size() < 1 || isValidImageUrl(urls[0])) &&
        (urls.size() < 2 || isValidImageUrl(urls[1])) &&
        (urls.size() < 3 || isValidImageUrl(urls[2])) &&
        (urls.size() < 4 || isValidImageUrl(urls[3])) &&
        (urls.size() < 5 || isValidImageUrl(urls[4])) &&
        (urls.size() < 6 || isValidImageUrl(urls[5])) &&
        (urls.size() < 7 || isValidImageUrl(urls[6])) &&
        (urls.size() < 8 || isValidImageUrl(urls[7])) &&
        (urls.size() < 9 || isValidImageUrl(urls[8])) &&
        (urls.size() < 10 || isValidImageUrl(urls[9]));
    }

    function isValidNoticePayload(data) {
      return data.keys().hasAll([
        'title',
        'category',
        'dateLabel',
        'summary',
        'content',
        'imageUrl',
        'imageUrls',
        'isPinned',
        'isPublished',
        'authorId',
        'authorName',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title',
        'category',
        'dateLabel',
        'summary',
        'content',
        'imageUrl',
        'imageUrls',
        'isPinned',
        'isPublished',
        'authorId',
        'authorName',
        'createdAt',
        'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
      data.category is string && data.category.size() <= 40 && isValidCategory(data.category) &&
      data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 30 &&
      data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 240 &&
      data.content is string && data.content.size() >= 2 && data.content.size() <= 5000 &&
      isValidImageUrl(data.imageUrl) &&
      isValidImageUrls(data.imageUrls) &&
      data.isPinned is bool &&
      data.isPublished is bool &&
      data.authorId is string && isValidId(data.authorId) &&
      data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidHistoryPayload(data) {
      return data.keys().hasAll([
        'year',
        'date',
        'title',
        'location',
        'sortOrder',
        'isPublished',
        'authorId',
        'authorName',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'year',
        'date',
        'title',
        'location',
        'sortOrder',
        'isPublished',
        'authorId',
        'authorName',
        'createdAt',
        'updatedAt'
      ]) &&
      data.year is string && data.year.size() == 4 && data.year.matches('^(19|20)[0-9]{2}$') &&
      data.date is string && data.date.size() >= 1 && data.date.size() <= 40 &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
      data.location is string && data.location.size() <= 100 &&
      data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 99999999 &&
      data.isPublished is bool &&
      data.authorId is string && isValidId(data.authorId) &&
      data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidParticipantPayload(data) {
      return data.keys().hasAll([
        'photoUrl',
        'name',
        'telegramId',
        'cohort',
        'phone',
        'shortAddress',
        'authorId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'photoUrl',
        'name',
        'telegramId',
        'cohort',
        'phone',
        'shortAddress',
        'authorId',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidImageUrl(data.photoUrl) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
      data.telegramId is string && data.telegramId.size() <= 64 &&
      data.cohort is string && data.cohort.size() >= 1 && data.cohort.size() <= 40 &&
      data.phone is string && data.phone.size() <= 30 &&
      data.shortAddress is string && data.shortAddress.size() <= 120 &&
      data.authorId is string && isValidId(data.authorId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdminPayload(data) {
      return data.keys().hasAll(['email', 'displayName', 'addedBy', 'createdAt']) &&
      data.keys().hasOnly(['email', 'displayName', 'addedBy', 'createdAt']) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
      data.addedBy is string && isValidId(data.addedBy) &&
      data.createdAt is timestamp;
    }

    function isValidInquiryStatus(status) {
      return status in ['대기중', '확인됨', '답변완료'];
    }

    function isValidInquiryPayload(data) {
      return data.keys().hasAll([
        'name',
        'contact',
        'topic',
        'message',
        'status',
        'adminNote',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'name',
        'contact',
        'topic',
        'message',
        'status',
        'adminNote',
        'createdAt',
        'updatedAt'
      ]) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
      data.contact is string && data.contact.size() >= 4 && data.contact.size() <= 100 &&
      data.topic is string && data.topic.size() >= 2 && data.topic.size() <= 80 &&
      data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
      data.status is string && data.status.size() <= 20 && isValidInquiryStatus(data.status) &&
      data.adminNote is string && data.adminNote.size() <= 1000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // --- Collection: /notices/{noticeId} ---
    match /notices/{noticeId} {
      allow get: if isValidId(noticeId) && (
        existing().isPublished == true || isAdmin()
      );

      allow list: if existing().isPublished == true || isBootstrappedAdmin();

      allow create: if isValidId(noticeId) &&
        isAdmin() &&
        isValidNoticePayload(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(noticeId) &&
        isAdmin() &&
        isValidNoticePayload(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'category',
          'dateLabel',
          'summary',
          'content',
          'imageUrl',
          'imageUrls',
          'isPinned',
          'isPublished',
          'authorName',
          'updatedAt'
        ]);

      allow delete: if isValidId(noticeId) && isAdmin();
    }

    // --- Collection: /histories/{historyId} ---
    match /histories/{historyId} {
      allow get: if isValidId(historyId) && (
        existing().isPublished == true || isAdmin()
      );

      allow list: if existing().isPublished == true || isBootstrappedAdmin();

      allow create: if isValidId(historyId) &&
        isAdmin() &&
        isValidHistoryPayload(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(historyId) &&
        isAdmin() &&
        isValidHistoryPayload(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'year',
          'date',
          'title',
          'location',
          'sortOrder',
          'isPublished',
          'authorName',
          'updatedAt'
        ]);

      allow delete: if isValidId(historyId) && isAdmin();
    }

    // --- Collection: /participants/{participantId} (Strict PII Isolation) ---
    match /participants/{participantId} {
      allow get: if isValidId(participantId) && isBootstrappedAdmin();

      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(participantId) &&
        isBootstrappedAdmin() &&
        isValidParticipantPayload(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(participantId) &&
        isBootstrappedAdmin() &&
        isValidParticipantPayload(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'photoUrl',
          'name',
          'telegramId',
          'cohort',
          'phone',
          'shortAddress',
          'updatedAt'
        ]);

      allow delete: if isValidId(participantId) && isBootstrappedAdmin();
    }

    // --- Collection: /admins/{adminId} ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isEmailVerified() && (
        request.auth.uid == adminId || isBootstrappedAdmin()
      );

      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(adminId) &&
        isBootstrappedAdmin() &&
        isValidAdminPayload(incoming()) &&
        incoming().addedBy == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update: if isValidId(adminId) &&
        isBootstrappedAdmin() &&
        isValidAdminPayload(incoming()) &&
        incoming().addedBy == existing().addedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName']);

      allow delete: if isValidId(adminId) && isBootstrappedAdmin();
    }

    // --- Collection: /inquiries/{inquiryId} (Public Submit, Bootstrapped Admin Read/Manage Only) ---
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isBootstrappedAdmin();

      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(inquiryId) &&
        isValidInquiryPayload(incoming()) &&
        incoming().status == '대기중' &&
        incoming().adminNote == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(inquiryId) &&
        isBootstrappedAdmin() &&
        isValidInquiryPayload(incoming()) &&
        incoming().name == existing().name &&
        incoming().contact == existing().contact &&
        incoming().topic == existing().topic &&
        incoming().message == existing().message &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'adminNote',
          'updatedAt'
        ]);

      allow delete: if isValidId(inquiryId) && isBootstrappedAdmin();
    }
  }
}
