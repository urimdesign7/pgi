{
  "entities": {
    "Notice": {
      "title": "Notice",
      "description": "PGI 선교회 공식 공지사항 게시물",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "공지사항 제목",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "커뮤니티 분류 (공지 / 갤러리)",
          "enum": [
            "공지",
            "갤러리",
            "기도말씀 컨퍼런스",
            "화요예배",
            "제자스쿨",
            "청청캠프",
            "공지사항"
          ],
          "maxLength": 40
        },
        "dateLabel": {
          "type": "string",
          "description": "표시용 날짜 문자열",
          "minLength": 1,
          "maxLength": 30
        },
        "summary": {
          "type": "string",
          "description": "목록 요약 문구",
          "minLength": 2,
          "maxLength": 240
        },
        "content": {
          "type": "string",
          "description": "공지사항 본문 전체 내용",
          "minLength": 2,
          "maxLength": 5000
        },
        "imageUrl": {
          "type": "string",
          "description": "대표 첨부 이미지 URL 또는 압축된 래스터 이미지 Data URL (미첨부 시 빈 문자열)",
          "minLength": 0,
          "maxLength": 400000
        },
        "imageUrls": {
          "type": "array",
          "description": "커뮤니티/갤러리 첨부 이미지 목록 (갤러리는 최대 10장까지 지원)",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 400000
          }
        },
        "isPinned": {
          "type": "boolean",
          "description": "상단 고정 여부"
        },
        "isPublished": {
          "type": "boolean",
          "description": "공개 게시 여부 (false일 경우 관리자만 열람 가능)"
        },
        "authorId": {
          "type": "string",
          "description": "작성 관리자 UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "작성자 표기명",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "서버 생성 시각 (serverTimestamp)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "서버 최종 수정 시각 (serverTimestamp)"
        }
      },
      "required": [
        "title",
        "category",
        "dateLabel",
        "summary",
        "content",
        "imageUrl",
        "imageUrls",
        "isPinned",
        "isPublished",
        "authorId",
        "authorName",
        "createdAt",
        "updatedAt"
      ]
    },
    "HistoryEvent": {
      "title": "HistoryEvent",
      "description": "PGI 선교회 연혁 항목",
      "type": "object",
      "properties": {
        "year": {
          "type": "string",
          "description": "연혁 연도 (4자리 숫자)",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^(19|20)[0-9]{2}$"
        },
        "date": {
          "type": "string",
          "description": "세부 날짜 또는 기간 문자열",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "description": "연혁 사역 내용 및 제목",
          "minLength": 2,
          "maxLength": 140
        },
        "location": {
          "type": "string",
          "description": "사역 장소 (선택, 미입력 시 빈 문자열)",
          "minLength": 0,
          "maxLength": 100
        },
        "sortOrder": {
          "type": "number",
          "description": "연도 내 정렬 순서 (월일 기반 정수, 높을수록 최신)"
        },
        "isPublished": {
          "type": "boolean",
          "description": "홈페이지 연혁 공개 여부"
        },
        "authorId": {
          "type": "string",
          "description": "작성 관리자 UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "작성자 표기명",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "서버 생성 시각 (serverTimestamp)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "서버 최종 수정 시각 (serverTimestamp)"
        }
      },
      "required": [
        "year",
        "date",
        "title",
        "location",
        "sortOrder",
        "isPublished",
        "authorId",
        "authorName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Participant": {
      "title": "Participant",
      "description": "PGI 선교회 사역·훈련 참가자 관리 정보 (개인정보 포함, 관리자 전용)",
      "type": "object",
      "properties": {
        "photoUrl": {
          "type": "string",
          "description": "참가자 사진 URL 또는 압축된 래스터 이미지 Data URL (미등록 시 빈 문자열)",
          "minLength": 0,
          "maxLength": 400000
        },
        "name": {
          "type": "string",
          "description": "참가자 이름",
          "minLength": 1,
          "maxLength": 60
        },
        "telegramId": {
          "type": "string",
          "description": "텔레그램 아이디",
          "minLength": 0,
          "maxLength": 64
        },
        "cohort": {
          "type": "string",
          "description": "참여 기수 (예: 9기, 제자스쿨 3기 등)",
          "minLength": 1,
          "maxLength": 40
        },
        "phone": {
          "type": "string",
          "description": "전화번호",
          "minLength": 0,
          "maxLength": 30
        },
        "shortAddress": {
          "type": "string",
          "description": "약식 주소",
          "minLength": 0,
          "maxLength": 120
        },
        "authorId": {
          "type": "string",
          "description": "등록 관리자 UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "서버 생성 시각 (serverTimestamp)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "서버 최종 수정 시각 (serverTimestamp)"
        }
      },
      "required": [
        "photoUrl",
        "name",
        "telegramId",
        "cohort",
        "phone",
        "shortAddress",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "PGI 선교회 관리자 권한을 부여받은 관리자 계정",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "관리자 이메일 주소",
          "minLength": 3,
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "description": "관리자 표시 이름",
          "minLength": 1,
          "maxLength": 60
        },
        "addedBy": {
          "type": "string",
          "description": "권한 부여 관리자 UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "등록 시각 (serverTimestamp)"
        }
      },
      "required": ["email", "displayName", "addedBy", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "방문자가 접수한 훈련 신청 및 사역 문의 (개인정보 포함, 열람·처리는 대표 관리자 전용)",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "성함 또는 소속",
          "minLength": 2,
          "maxLength": 60
        },
        "contact": {
          "type": "string",
          "description": "연락처 (전화번호 또는 이메일)",
          "minLength": 4,
          "maxLength": 100
        },
        "topic": {
          "type": "string",
          "description": "문의 구분",
          "minLength": 2,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "description": "문의 내용",
          "minLength": 5,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "description": "처리 상태",
          "enum": ["대기중", "확인됨", "답변완료"],
          "maxLength": 20
        },
        "adminNote": {
          "type": "string",
          "description": "관리자 처리 메모",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "접수 시각 (serverTimestamp)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "최종 수정 시각 (serverTimestamp)"
        }
      },
      "required": [
        "name",
        "contact",
        "topic",
        "message",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "PGI 선교회 공식 공지사항 컬렉션 (공개 게시물은 누구나 열람 가능, 작성·수정·삭제 및 비공개 열람은 인증된 관리자 전용)"
    },
    "/histories/{historyId}": {
      "schema": { "$ref": "#/entities/HistoryEvent" },
      "description": "PGI 선교회 걸어온 길(연혁) 컬렉션 (공개 항목은 누구나 열람 가능, 추가·수정·삭제 및 비공개 열람은 인증된 관리자 전용)"
    },
    "/participants/{participantId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "PGI 선교회 참가자 개인정보(사진, 이름, 텔레아이디, 참여기수, 전화번호, 약식주소) 컬렉션 (대표 관리자 전용)"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "추가 관리자 UID 화이트리스트 컬렉션 (대표 관리자 전용 관리)"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "훈련 신청 및 사역 문의 접수 컬렉션 (방문자 생성 가능, 열람·상태변경·삭제는 대표 관리자 전용)"
    }
  }
}
